# Native macOS development: `docker compose up -d mongo`, then `pnpm dev`.
MONGODB_URI=mongodb://localhost:27017/mynote
MONGODB_DB_NAME=mynote

# Generate locally, for example: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# OAuth is optional until a provider is configured. Configure both values as a pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
