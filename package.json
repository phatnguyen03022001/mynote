    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "mongodb": "7.6.0",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
